---
import ArrowRight from "phosphor-astro/ArrowRight.astro";
import { getCollection } from "astro:content";
import { SITE_NAME } from "../../consts.js";
import SiteLayout from "../../layouts/SiteLayout.astro";

const authors = await getCollection("authors");
const posts = await getCollection("blog");
const authorCards = authors
	.map(author => ({ author, count: posts.filter(post => post.data.authors.some(reference => reference.id === author.id)).length }))
	.filter(item => item.count > 0)
	.sort((a, b) => b.count - a.count || a.author.data.name.localeCompare(b.author.data.name));
const pageURL = new URL("/authors/", Astro.site).href;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"@id": `${pageURL}#authors`,
	url: pageURL,
	name: `${SITE_NAME} 作者`,
	description: "BambooFox 技術文章、課程資料與 CTF Write-up 的作者列表。",
	mainEntity: {
		"@type": "ItemList",
		itemListElement: authorCards.map(({ author }, index) => ({ "@type": "ListItem", position: index + 1, name: author.data.name, url: new URL(`/authors/${author.id}/`, Astro.site).href }))
	}
};
---

<SiteLayout title={`作者｜${SITE_NAME}`} description="BambooFox 技術文章、課程資料與 CTF Write-up 的作者列表。" jsonLd={jsonLd} mainClass="authors-page">
	<section class="authors-hero shell">
		<p class="eyebrow">Contributors</p>
		<h1>文章作者</h1>
		<p>作者資料依文章署名與 BambooFox 舊站 Git 歷史整理。多人協作文章會完整列出共同作者。</p>
	</section>

	<section class="author-list shell" aria-label="作者列表">
		{
			authorCards.map(({ author, count }) => (
				<a href={`/authors/${author.id}/`}>
					<div class="author-summary">
						<img src={author.data.avatar} width="72" height="72" alt="" loading="lazy" decoding="async" />
						<div>
							<strong>{author.data.name}</strong>
							<p>{author.data.description}</p>
						</div>
					</div>
					<span>
						{count} 篇文章 <ArrowRight width={18} height={18} weight="bold" aria-hidden="true" />
					</span>
				</a>
			))
		}
	</section>
</SiteLayout>

<style>
	.authors-hero {
		padding-block: 7rem 4rem;
		border-bottom: 1px solid var(--line);
	}

	.authors-hero h1 {
		margin-bottom: 1rem;
		font-size: clamp(3.3rem, 7vw, 6.8rem);
	}

	.authors-hero > p:last-child {
		max-width: 680px;
		color: var(--muted);
	}

	.author-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin-block: 3rem 8rem;
		border: 1px solid var(--line);
		background: var(--line);
	}

	.author-list > a {
		display: flex;
		min-height: 190px;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 2rem;
		background: var(--pine-900);
	}

	.author-summary {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 1.2rem;
	}

	.author-summary img {
		width: 72px;
		max-width: 100%;
		height: 72px;
		flex: 0 0 auto;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		background: var(--pine-950);
		object-fit: cover;
	}

	.author-list > a:hover strong,
	.author-list > a:hover > span {
		color: var(--orange-soft);
	}

	.author-list strong {
		font-size: 1.35rem;
	}

	.author-list p {
		max-width: 430px;
		margin: 0.55rem 0 0;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.author-list > a > span {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
	}

	@media (max-width: 760px) {
		.author-list {
			grid-template-columns: 1fr;
		}

		.author-list > a {
			min-height: 160px;
			align-items: flex-start;
			flex-direction: column;
		}

		.author-summary {
			align-items: flex-start;
		}
	}
</style>
