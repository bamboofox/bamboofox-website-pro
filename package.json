{
	"name": "bamboofox-website",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"assets:brand": "node scripts/generate-brand-assets.mjs",
		"astro": "astro",
		"avatars:sync": "node scripts/archive-author-avatars.mjs",
		"build": "astro build",
